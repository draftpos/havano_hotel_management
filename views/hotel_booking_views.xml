<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Check-In Views -->
    
    <!-- Reservation Views -->
    <record id="view_hotel_reservation_form" model="ir.ui.view">
        <field name="name">hotel.reservation.form</field>
        <field name="model">hotel.reservation</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="room_id" required="1" domain="[('status', 'in', ['available', 'reserved'])]"/>
                        <field name="guest_id"/>
                        <field name="arrival_date"/>
                        <field name="departure_date" readonly="1"/>
                        <field name="nights"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_create_reservation" string="Create Reservation" type="object" class="btn-primary" invisible="id != False"/>
                    <button special="cancel" data-hotkey="z" string="Close" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_hotel_reservation_tree" model="ir.ui.view">
        <field name="name">hotel.reservation.tree</field>
        <field name="model">hotel.reservation</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="guest_id"/>
                <field name="room_id"/>
                <field name="arrival_date"/>
                <field name="departure_date"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <!-- Payment Wizard View -->
    <record id="view_hotel_payment_wizard_form" model="ir.ui.view">
        <field name="name">hotel.payment.wizard.form</field>
        <field name="model">hotel.payment.wizard</field>
        <field name="arch" type="xml">
            <form string="Make Payment">
                <sheet>
                    <group>
                        <field name="room_id" options="{'no_create': True}"/>
                        <field name="checkin_id" readonly="1" force_save="1"/>
                        <field name="guest_id" readonly="1" force_save="1"/>
                        <field name="invoice_id" readonly="1" force_save="1"/>
                        <field name="total_amount" force_save="1"/>
                        <field name="amount"/>
                        <field name="payment_method_id" options="{'no_create': True}"/>
                        <field name="payment_date"/>
                        <field name="reference_no"/>
                        <field name="reference_date"/>
                        <field name="remarks"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_make_payment" string="Make Payment" type="object" class="btn-primary"/>
                    <button special="cancel" data-hotkey="z" string="Close" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Booking Views -->
    <record id="view_hotel_booking_tree" model="ir.ui.view">
        <field name="name">hotel.booking.tree</field>
        <field name="model">hotel.booking</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="reservation_id"/>
                <field name="guest_id"/>
                <field name="check_in_by"/>
                <field name="invoice_id"/>
            </list>
        </field>
    </record>

    <record id="view_hotel_booking_form" model="ir.ui.view">
        <field name="name">hotel.booking.form</field>
        <field name="model">hotel.booking</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Booking Reference"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="reservation_id"/>
                            <field name="guest_id"/>
                            <field name="venue_id"/>
                        </group>
                        <group>
                            <field name="check_in_by"/>
                            <field name="invoice_id"/>
                            <field name="payment_entry_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hotel_booking" model="ir.actions.act_window">
        <field name="name">Bookings</field>
        <field name="res_model">hotel.booking</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Checkout Views -->
    <record id="view_hotel_checkout_tree" model="ir.ui.view">
        <field name="name">hotel.checkout.tree</field>
        <field name="model">hotel.checkout</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="checkin_id"/>
                <field name="guest_id"/>
                <field name="room_id"/>
                <field name="checkout_by"/>
            </list>
        </field>
    </record>

    <record id="view_hotel_checkout_form" model="ir.ui.view">
        <field name="name">hotel.checkout.form</field>
        <field name="model">hotel.checkout</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="room_id" required="1" domain="[('status', '=', 'occupied')]"/>
                        <field name="checkin_id" readonly="1" force_save="1"/>
                        <field name="guest_id" readonly="1" force_save="1"/>
                        <field name="actual_checkout_time"/>
                        <field name="housekeeping_status"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_checkout" string="Check Out" type="object" class="btn-primary"/>
                    <button special="cancel" data-hotkey="z" string="Close" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hotel_checkout" model="ir.actions.act_window">
        <field name="name">Check Outs</field>
        <field name="res_model">hotel.checkout</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

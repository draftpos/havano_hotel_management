<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Room Views -->
    <!-- Housekeeping Wizard View -->
    <record id="view_hotel_housekeeping_wizard_form" model="ir.ui.view">
        <field name="name">hotel.housekeeping.wizard.form</field>
        <field name="model">hotel.housekeeping.wizard</field>
        <field name="arch" type="xml">
            <form string="Update House Keeping Status">
                <sheet>
                    <group>
                        <field name="room_id"/>
                        <field name="housekeeping_status"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_update" string="Update" type="object" class="btn-primary"/>
                    <button special="cancel" data-hotkey="z" string="Close" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_hotel_room_tree" model="ir.ui.view">
        <field name="name">hotel.room.tree</field>
        <field name="model">hotel.room</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="room_type_id"/>
                <field name="floor_id"/>
                <field name="status"/>
                <field name="housekeeping_status"/>
                <field name="price"/>
                <field name="guest_name"/>
            </list>
        </field>
    </record>

    <record id="view_hotel_room_form" model="ir.ui.view">
        <field name="name">hotel.room.form</field>
        <field name="model">hotel.room</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="room_type_id"/>
                            <field name="floor_id"/>
                            <field name="product_id"/>
                            <field name="price"/>
                        </group>
                        <group>
                            <field name="status"/>
                            <field name="housekeeping_status"/>
                            <field name="current_guest_id"/>
                            <field name="checkout_date"/>
                            <field name="checkout_status"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Amenities">
                            <field name="amenity_ids">
                                <list>
                                    <field name="name"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hotel_room" model="ir.actions.act_window">
        <field name="name">Rooms</field>
        <field name="res_model">hotel.room</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Venue Views -->
    <record id="view_hotel_venue_tree" model="ir.ui.view">
        <field name="name">hotel.venue.tree</field>
        <field name="model">hotel.venue</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="status"/>
                <field name="price"/>
                <field name="housekeeping_status"/>
                <field name="venue_item_id"/>
                <field name="current_guest_id"/>
            </list>
        </field>
    </record>

    <record id="view_hotel_venue_form" model="ir.ui.view">
        <field name="name">hotel.venue.form</field>
        <field name="model">hotel.venue</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Venue Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="status"/>
                            <field name="housekeeping_status"/>
                            <field name="price"/>
                            <field name="venue_item_id"/>
                        </group>
                        <group>
                            <field name="current_guest_id"/>
                            <field name="company_id"/>
                            <field name="cost_center_id"/>
                            <field name="rate_type_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hotel_venue" model="ir.actions.act_window">
        <field name="name">Venues</field>
        <field name="res_model">hotel.venue</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

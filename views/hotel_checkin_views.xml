<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Check-In Views -->
    <record id="view_hotel_checkin_tree" model="ir.ui.view">
        <field name="name">hotel.checkin.tree</field>
        <field name="model">hotel.checkin</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="room_id"/>
                <field name="guest_id"/>
                <field name="check_in_date"/>
                <field name="check_out_date"/>
                <field name="nights"/>
                <field name="checkout_status"/>
                <field name="balance_due"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'checked_in'" decoration-warning="state == 'checked_out'"/>
            </list>
        </field>
    </record>

    <record id="view_hotel_checkin_form" model="ir.ui.view">
        <field name="name">hotel.checkin.form</field>
        <field name="model">hotel.checkin</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_checkin" string="Save &amp; Submit" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    
                    <button name="action_make_payment" string="Make Payment" type="object" class="btn-success" invisible="state == 'draft'"/>
                    <button name="action_extra_charges" string="Extra Charges" type="object" class="btn-secondary" invisible="state == 'draft'"/>
                    <button name="action_move_room" string="Move Room" type="object" class="btn-secondary" invisible="state == 'draft'"/>
                    <button name="action_extend_stay" string="Extend Stay" type="object" class="btn-secondary" invisible="state == 'draft'"/>
                    <button name="action_checkout_modal" string="Check Out" type="object" class="btn-warning" invisible="state != 'checked_in'"/>
                    
                    <field name="state" widget="statusbar" statusbar_visible="draft,checked_in,checked_out"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Check In Details">
                            <field name="reservation_id" readonly="state != 'draft'"/>
                            <field name="guest_id" readonly="state != 'draft'"/>
                            <label for="room_id"/>
                            <div class="o_row">
                                <field name="room_housekeeping_status" invisible="1"/>
                                <field name="room_id" readonly="state != 'draft'" domain="[('status', 'in', ['available', 'reserved'])]" nolabel="1"/>
                                <button name="action_clean_room" type="object" string="Clean Room" class="btn-link text-warning" icon="fa-paint-brush" invisible="not room_id or state != 'draft' or room_housekeeping_status == 'clean'"/>
                            </div>
                            <field name="allow_overbooking" readonly="state != 'draft'"/>
                            <field name="check_in_date" readonly="state != 'draft'"/>
                            <field name="nights" readonly="state != 'draft'"/>
                            <field name="check_out_date" readonly="state != 'draft'"/>
                        </group>
                        <group string="Pricing &amp; Status">
                            <field name="payment_status" readonly="state != 'draft'" widget="radio" options="{'horizontal': true}"/>
                            <field name="payment_amount" readonly="state != 'draft'" invisible="payment_status != 'paid'"/>
                            <field name="payment_journal_id" readonly="state != 'draft'" invisible="payment_status != 'paid'" required="payment_status == 'paid'"/>
                            <field name="payment_reference" readonly="state != 'draft'" invisible="payment_status != 'paid'"/>
                            <field name="rate_type_id" readonly="state != 'draft'"/>
                            <field name="rate" readonly="state != 'draft'"/>
                            <field name="total_charge" readonly="1" style="font-weight: bold;"/>
                            <field name="checkout_status" readonly="1"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Guest Details">
                            <group>
                                <group>
                                    <field name="num_adults" readonly="state != 'draft'"/>
                                    <field name="num_children" readonly="state != 'draft'"/>
                                    <field name="has_multiple_guests" readonly="state != 'draft'"/>
                                </group>
                                <group>
                                    <field name="guest_vehicle" readonly="state != 'draft'"/>
                                    <field name="transport_mode_id" readonly="state != 'draft'"/>
                                    <field name="business_source_id" readonly="state != 'draft'"/>
                                </group>
                            </group>
                            <field name="notes" placeholder="Additional Notes..." readonly="state != 'draft'"/>
                        </page>
                        <page string="Other Guests" invisible="has_multiple_guests == False">
                            <field name="other_guest_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="guest_id"/>
                                    <field name="guest_note"/>
                                </list>
                            </field>
                        </page>
                        <page string="General Ledger &amp; Billing">
                            <group>
                                <group>
                                    <field name="total_charge" readonly="1"/>
                                    <field name="amount_paid" readonly="1"/>
                                    <field name="balance_due" readonly="1" style="font-weight: bold; color: red;" invisible="balance_due &lt;= 0"/>
                                    <field name="balance_due" readonly="1" style="font-weight: bold; color: green;" invisible="balance_due &gt; 0"/>
                                </group>
                            </group>
                            <!-- Placeholder for custom HTML General Ledger -->
                            <div class="mt-3">
                                <h3>Account Ledger</h3>
                                <p class="text-muted">A detailed view of transactions and payments will appear here.</p>
                            </div>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button name="action_checkin" string="Save &amp; Submit" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button special="cancel" data-hotkey="z" string="Close" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hotel_checkin" model="ir.actions.act_window">
        <field name="name">Check-Ins</field>
        <field name="res_model">hotel.checkin</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

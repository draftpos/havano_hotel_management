<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Housekeeping Views -->
    <record id="view_hotel_housekeeping_tree" model="ir.ui.view">
        <field name="name">hotel.housekeeping.tree</field>
        <field name="model">hotel.housekeeping</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="room_id"/>
                <field name="assigned_staff_id"/>
                <field name="status"/>
                <field name="date"/>
            </list>
        </field>
    </record>

    <record id="view_hotel_housekeeping_form" model="ir.ui.view">
        <field name="name">hotel.housekeeping.form</field>
        <field name="model">hotel.housekeeping</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Task Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="room_id"/>
                            <field name="assigned_staff_id"/>
                        </group>
                        <group>
                            <field name="date"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hotel_housekeeping" model="ir.actions.act_window">
        <field name="name">Housekeeping</field>
        <field name="res_model">hotel.housekeeping</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
